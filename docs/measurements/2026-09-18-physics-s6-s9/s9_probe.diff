 criterion_group!(benches, bench_sleeping_pipeline);
-criterion_main!(benches);
+// MQ-PROBE (MEASUREMENT-QUEUE §9 R2; never committed, never timed): the live contact-point
+// count of the bench's OWN piles, per step, from construction onward. No timing is taken.
+// The piles are built and warmed exactly as `bench_sleeping_pipeline` builds them (off, awake,
+// frozen, then WARM_STEPS interleaved), so step N here is step N of the timed binary's pile.
+fn mq_probe_points(pile: &Pile) -> (usize, u64) {
+    let manifolds = pile.world.resource::<Manifolds>().manifolds();
+    let live = manifolds.iter().filter(|m| m.count > 0).count();
+    let points = manifolds.iter().map(|m| u64::from(m.count)).sum();
+    (live, points)
+}
+
+fn main() {
+    let steps: usize = std::env::var("MQ_PROBE_STEPS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .expect("probe: set MQ_PROBE_STEPS");
+    let mut off = Pile::new(0.0, Vec3::new(0.0, -9.81, 0.0), false, None);
+    let mut awake = Pile::new(JOLT_SEPARATION, Vec3::new(0.0, -9.81, 0.0), true, Some(0.0));
+    let frozen = frozen_pile();
+    let (fl, fp) = mq_probe_points(&frozen);
+    eprintln!("probe: frozen pile live manifolds {fl}, points {fp}");
+    println!("arm,step,manifolds_live,points");
+    let mut off_series = Vec::with_capacity(steps);
+    for step in 1..=steps {
+        off.step();
+        let (l, p) = mq_probe_points(&off);
+        off_series.push((l, p));
+        println!("pyramid_sleeping_off,{step},{l},{p}");
+        awake.step();
+        let (l, p) = mq_probe_points(&awake);
+        println!("pyramid_awake_sleeping_on,{step},{l},{p}");
+    }
+    // Replay: a second, fresh off pile must reproduce the series (the premise that the
+    // probe's trajectory is the timed binary's trajectory rests on determinism).
+    let replay = steps.min(300);
+    let mut again = Pile::new(0.0, Vec3::new(0.0, -9.81, 0.0), false, None);
+    for (i, expected) in off_series.iter().take(replay).enumerate() {
+        again.step();
+        assert_eq!(mq_probe_points(&again), *expected, "probe: replay diverged at step {}", i + 1);
+    }
+    eprintln!("probe: fresh off pile replayed the first {replay} steps identically");
+}
