{
  "name": "Rusty Steel Light Gray",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "enumMember": {
      "foreground": "#56d1b1"
    },
    "variable.constant": {
      "foreground": "#98bde4"
    },
    "variable.defaultLibrary": {
      "foreground": "#ffe3a1"
    },
    "keyword": {
      "foreground": "#cc7aff"
    },
    "keyword.control": {
      "foreground": "#cc7aff"
    },
    "keyword.function": {
      "foreground": "#ff9d45"
    },
    "function.declaration": {
      "foreground": "#82b1ff"
    },
    "type": {
      "foreground": "#7ee6b8"
    },
    "struct": {
      "foreground": "#7ee6b8"
    },
    "enum": {
      "foreground": "#7ee6b8"
    },
    "typeParameter": {
      "foreground": "#ffcb6b"
    },
    "interface": {
      "foreground": "#7ee6b8"
    },
    "namespace": {
      "foreground": "#82b1ff"
    }
  },
  "tokenColors": [
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#618c67",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust doc comments",
      "scope": "comment.line.documentation.rust, comment.block.documentation.rust",
      "settings": {
        "foreground": "#7cbe8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#a9de82"
      }
    },
    {
      "name": "Rust string literals",
      "scope": "string.quoted.double.rust, string.quoted.single.rust",
      "settings": {
        "foreground": "#a9de82"
      }
    },
    {
      "name": "Rust raw string literals",
      "scope": "string.quoted.raw.rust",
      "settings": {
        "foreground": "#8ec68f"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "Rust numeric literals",
      "scope": "constant.numeric.decimal.rust, constant.numeric.integer.rust, constant.numeric.float.rust",
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "Constants",
      "scope": "constant",
      "settings": {
        "foreground": "#ffbe7a"
      }
    },
    {
      "name": "Rust boolean literals",
      "scope": "constant.language.bool.rust",
      "settings": {
        "foreground": "#ffbe7a"
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#82b1ff"
      }
    },
    {
      "name": "Rust function",
      "scope": "entity.name.function.rust",
      "settings": {
        "foreground": "#82b1ff"
      }
    },
    {
      "name": "Types",
      "scope": "entity.name.type, support.type",
      "settings": {
        "foreground": "#7ee6b8"
      }
    },
    {
      "name": "Rust types",
      "scope": "entity.name.type.struct.rust, entity.name.type.rust",
      "settings": {
        "foreground": "#7ee6b8"
      }
    },
    {
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#efefef"
      }
    },
    {
      "name": "Rust variables",
      "scope": "variable.other.rust",
      "settings": {
        "foreground": "#efefef"
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#bfc7ea",
        "fontStyle": ""
      }
    },
    {
      "name": "Rust parameters and arguments",
      "scope": "variable.parameter.rust",
      "settings": {
        "foreground": "#bfc7ea"
      }
    },
    {
      "name": "Rust closure parameter",
      "scope": "variable.parameter.rust entity.name.variable.parameter.rust",
      "settings": {
        "foreground": "#bfc7ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Storage Type",
      "scope": "storage.type",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Storage Modifier",
      "scope": "storage.modifier",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#d2e1ff"
      }
    },
    {
      "name": "Rust module path separator",
      "scope": "punctuation.separator.rust",
      "settings": {
        "foreground": "#d2e1ff"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Rust Self keyword",
      "scope": "variable.language.self.rust",
      "settings": {
        "foreground": "#4caf50",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust crate keyword",
      "scope": "keyword.other.crate.rust",
      "settings": {
        "foreground": "#ff9d45"
      }
    },
    {
      "name": "Rust pub visibility modifier",
      "scope": "storage.modifier.visibility.rust, keyword.other.pub.rust",
      "settings": {
        "foreground": "#f2c88c"
      }
    },
    {
      "name": "Rust use keyword",
      "scope": "keyword.other.use.rust, storage.type.use.rust",
      "settings": {
        "foreground": "#95e4c2"
      }
    },
    {
      "name": "Rust fn keyword",
      "scope": "storage.type.function.rust, keyword.other.fn.rust",
      "settings": {
        "foreground": "#ff9d45"
      }
    },
    {
      "name": "Rust struct keyword",
      "scope": "storage.type.struct.rust, keyword.other.struct.rust",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Rust enum keyword",
      "scope": "storage.type.enum.rust, keyword.other.enum.rust",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Rust impl keyword",
      "scope": "storage.type.impl.rust, keyword.other.impl.rust",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Rust trait keyword",
      "scope": "storage.type.trait.rust, keyword.other.trait.rust",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Rust mod keyword",
      "scope": "storage.type.module.rust, keyword.other.mod.rust",
      "settings": {
        "foreground": "#cc7aff"
      }
    },
    {
      "name": "Rust macros",
      "scope": "meta.macro.rust, support.function.macro.rust",
      "settings": {
        "foreground": "#e89a77"
      }
    },
    {
      "name": "Rust lifetime",
      "scope": "storage.modifier.lifetime.rust, entity.name.lifetime.rust",
      "settings": {
        "foreground": "#e67e80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust attributes",
      "scope": "meta.attribute.rust",
      "settings": {
        "foreground": "#d3a6ff"
      }
    },
    {
      "name": "Rust unsafe keyword",
      "scope": "keyword.other.unsafe.rust",
      "settings": {
        "foreground": "#ff5370",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Rust match keyword",
      "scope": "keyword.control.rust",
      "settings": {
        "foreground": "#f2c88c"
      }
    },
    {
      "name": "Rust flow control keywords",
      "scope": "keyword.control.flow.rust",
      "settings": {
        "foreground": "#c39ac9"
      }
    },
    {
      "name": "Rust return keyword",
      "scope": "keyword.control.return.rust",
      "settings": {
        "foreground": "#f4a262"
      }
    },
    {
      "name": "Rust loop keywords",
      "scope": "keyword.control.loop.rust",
      "settings": {
        "foreground": "#c39ac9"
      }
    },
    {
      "name": "Rust mut keyword",
      "scope": "storage.modifier.mut.rust",
      "settings": {
        "foreground": "#e89a77"
      }
    },
    {
      "name": "Rust derive attribute",
      "scope": "meta.attribute.rust entity.name.type.rust",
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "Rust associated type",
      "scope": "keyword.other.type.rust",
      "settings": {
        "foreground": "#7ee6b8"
      }
    },
    {
      "name": "Rust async/await keywords",
      "scope": "keyword.other.async.rust, keyword.control.await.rust",
      "settings": {
        "foreground": "#d3a6ff"
      }
    },
    {
      "name": "Rust static keyword",
      "scope": "storage.modifier.static.rust",
      "settings": {
        "foreground": "#f2c88c"
      }
    },
    {
      "name": "Rust const keyword",
      "scope": "storage.modifier.const.rust",
      "settings": {
        "foreground": "#f2c88c"
      }
    },
    {
      "name": "Rust panic macro",
      "scope": "support.function.panic.rust",
      "settings": {
        "foreground": "#ff5370",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Rust where keyword",
      "scope": "keyword.other.where.rust",
      "settings": {
        "foreground": "#cc7aff"
      }
    }
  ],
  "colors": {
    "editor.background": "#3b4147",
    "editor.foreground": "#f5f5f5",
    "editorLineNumber.foreground": "#a0a7b8",
    "editorLineNumber.activeForeground": "#e0e4f5",
    "editorCursor.foreground": "#e0e4f5",
    "editor.selectionBackground": "#58606f",
    "editor.selectionHighlightBackground": "#5a606f77",
    "editor.wordHighlightBackground": "#696f7f",
    "editor.findMatchBackground": "#6b8bd7",
    "editor.findMatchHighlightBackground": "#6b8bd766",
    "editorGroup.border": "#555a67",
    "editorGroupHeader.tabsBackground": "#363a44",
    "editorGroupHeader.tabsBorder": "#363a44",
    "tab.activeBackground": "#3d4147",
    "tab.inactiveBackground": "#363a44",
    "tab.activeForeground": "#f0f0f0",
    "tab.inactiveForeground": "#c0c8e0",
    "tab.activeBorderTop": "#79c5ff",
    "tab.border": "#363a44",
    "activityBar.background": "#343a44",
    "activityBar.foreground": "#f0f0f0",
    "activityBarBadge.background": "#77c5ff",
    "activityBarBadge.foreground": "#363a44",
    "sideBar.background": "#343a44",
    "sideBar.foreground": "#f0f0f0",
    "sideBarTitle.foreground": "#f0f0f0",
    "statusBar.background": "#343a44",
    "statusBar.foreground": "#f0f0f0",
    "titleBar.activeBackground": "#343a44",
    "titleBar.activeForeground": "#f0f0f0",
    "terminal.background": "#343a44",
    "terminal.foreground": "#f0f0f0"
  }
} 