// Pillar B increment B2: the per-instance TRS interpolation compute PRE-PASS
// (`interp_instances.comp.hlsl`).
//
// One invocation per instance. Each thread reads a `TransformPair` (the previous +
// current simulation-substep TRS of one entity) at binding 0, interpolates it at the
// frame-wide `alpha` (the fixed-timestep overstep fraction, in [0, 1)), composes the
// result into the 3×4 ROW-MAJOR model affine, and writes the 48-byte `InstanceModelCol`
// record at binding 1. The consumer (the gbuffer VS) reads that record UNCHANGED — this
// pass simply refreshes the model column each frame from the interpolated pose instead
// of the raw current pose.
//
// The INTERPOLATION MATH BODY (`interp_trs`) is MACHINE-GENERATED by
// `boyko_shaderdsl::emit::emit_hlsl_transform_interp()` — the eDSL whose `f32` Eval
// backend IS the CPU oracle (its composed rows byte-match
// `boyko_render::InstanceModelCol::from_global` for the interpolated TRS). It is spliced
// between the `// === GENERATED interp_trs BEGIN/END ===` sentinels below. A hand-edit
// of that span — which would silently diverge the GPU interpolation from the host oracle
// — fails the `interp_edsl_sync` test in CI. To regenerate + re-splice:
//   cargo run -p boyko_shaderdsl --features emit --bin emit_field   (adds interp_trs)
// then re-DXC this file (the `interp_edsl_sync` test re-DXCs it and byte-compares).
//
// The B3 increment WIRES this pass into the frame (the descriptor sets + the dispatch);
// this file + its `.spv` are the B2 deliverable (shader + goldens only).
//
// Compiled offline (hermetic build) with:
//   dxc.exe -spirv -T cs_6_0 -E main -fspv-target-env=vulkan1.3 \
//       interp_instances.comp.hlsl -Fo interp_instances.comp.spv

// One decomposed transform: position, rotation (unit quaternion, xyzw — the engine's
// glTF/GPU convention), and per-axis scale. All-`float4` packing (xyz + one pad lane per
// vector) keeps the record 16-byte aligned and std430-straddle-free: `pos` at byte 0,
// `rot` at 16, `scale` at 32 — a 48-byte TRS. The `.w` pad of `pos`/`scale` is unused.
struct Trs {
    float4 pos;    // xyz = translation, w = pad
    float4 rot;    // xyzw = unit quaternion (x, y, z, w)
    float4 scale;  // xyz = per-axis scale, w = pad
};

// One previous → current pair (the B1 packer's output, the B3 dispatch's input). 96 B:
// `prev` at byte 0, `curr` at 48. The host `TransformPair` mirror (in boyko_shaderdsl /
// boyko_render) pins this layout with const asserts.
struct TransformPair {
    Trs prev;
    Trs curr;
};

// The 3×4 ROW-MAJOR model affine `interp_trs` returns — byte-identical to
// `boyko_render::InstanceModelCol` (`rows[i] = [linear_row_i.xyz | translation_i]`, 48 B).
struct InterpModel {
    float4 row0;
    float4 row1;
    float4 row2;
};

// binding 0: the per-instance previous/current TRS pairs (read-only input, B1's output).
StructuredBuffer<TransformPair> Pairs : register(t0);

// binding 1: the per-instance 48-byte model affine (RW output). The gbuffer VS reads this
// buffer UNCHANGED as its `InstanceModelCol` instance column.
RWStructuredBuffer<InterpModel> ModelOut : register(u1);

// The interp push constants: the instance count (bounds guard) + the frame-wide overstep
// fraction alpha in [0, 1). Mirrors the host `InterpInstancesPush`.
struct InterpInstancesPush {
    uint  count;
    float alpha;
};
[[vk::push_constant]] InterpInstancesPush pc;

