[numthreads(64, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
    uint i = tid.x;
    if (i >= pc.count) {
        return;
    }
    ModelOut[i] = interp_trs(Pairs[i], pc.alpha);
}
