+// boyko parity patch (-receipt): counts the manifolds the contact listener sees per update, cache hits
+// included (the body pair cache reports every cached manifold through OnContactPersisted). Callbacks
+// arrive from every job thread, hence the atomics. Untimed: it is only installed under -receipt.
+class ReceiptContactListener : public ContactListener
+{
+public:
+	virtual void			OnContactAdded(const Body &inBody1, const Body &inBody2, const ContactManifold &inManifold, [[maybe_unused]] ContactSettings &ioSettings) override { Count(inBody1, inBody2, inManifold); }
+	virtual void			OnContactPersisted(const Body &inBody1, const Body &inBody2, const ContactManifold &inManifold, [[maybe_unused]] ContactSettings &ioSettings) override { Count(inBody1, inBody2, inManifold); }
+
+	void					Reset()								{ mManifolds = 0; mPoints = 0; mStatic = 0; mStaticStatic = 0; mStaticPoints = 0; }
+	uint					GetManifolds() const				{ return mManifolds.load(memory_order_relaxed); }
+	uint					GetPoints() const					{ return mPoints.load(memory_order_relaxed); }
+	uint					GetStatic() const					{ return mStatic.load(memory_order_relaxed); }			// boyko parity patch v2
+	uint					GetStaticStatic() const				{ return mStaticStatic.load(memory_order_relaxed); }	// boyko parity patch v2
+	uint					GetStaticPoints() const				{ return mStaticPoints.load(memory_order_relaxed); }	// boyko parity patch v2
+
+private:
+	void					Count(const Body &inBody1, const Body &inBody2, const ContactManifold &inManifold)
+	{
+		uint points = uint(inManifold.mRelativeContactPointsOn1.size());
+		mManifolds.fetch_add(1, memory_order_relaxed);
+		mPoints.fetch_add(points, memory_order_relaxed);
+		if (inBody1.IsStatic() || inBody2.IsStatic()) // boyko parity patch v2: manifolds with a static endpoint
+		{
+			(inBody1.IsStatic() && inBody2.IsStatic()? mStaticStatic : mStatic).fetch_add(1, memory_order_relaxed);
+			mStaticPoints.fetch_add(points, memory_order_relaxed);
+		}
+	}
+
+	atomic<uint>			mManifolds { 0 };
+	atomic<uint>			mPoints { 0 };
+	atomic<uint>			mStatic { 0 };
+	atomic<uint>			mStaticStatic { 0 };
+	atomic<uint>			mStaticPoints { 0 };
+};
+
+// boyko parity patch v2 (-sanity): one sanity CSV row's leading columns (up to `bodies,`), the state after
+// inStep steps: energies per unit J-T box mass, bounds, the centroid, non-finite bodies, over every dynamic
+// body (body index order = creation order on a fresh system)
+static string BoykoSanityRow(PhysicsSystem &inPhysicsSystem, uint inStep, double inInjected)
+{
+	BodyInterface &bi = inPhysicsSystem.GetBodyInterfaceNoLock();
+	Vec3 g = inPhysicsSystem.GetGravity();
+	BodyIDVector ids;
+	inPhysicsSystem.GetBodies(ids);
+	double e_lin = 0.0, e_rot = 0.0, e_pot = 0.0, max_speed = 0.0;
+	double mn[3] = { HUGE_VAL, HUGE_VAL, HUGE_VAL }, mx[3] = { -HUGE_VAL, -HUGE_VAL, -HUGE_VAL }, sum[3] = { 0.0, 0.0, 0.0 };
+	int nonfinite = 0, bodies = 0;
+	for (BodyID id : ids)
+	{
+		if (bi.GetMotionType(id) == EMotionType::Static)
+			continue;
+		++bodies;
+		Vec3 p = Vec3(bi.GetPosition(id)), v = bi.GetLinearVelocity(id), w = bi.GetAngularVelocity(id);
+		Quat q = bi.GetRotation(id);
+		float vals[13] = { p.GetX(), p.GetY(), p.GetZ(), q.GetX(), q.GetY(), q.GetZ(), q.GetW(), v.GetX(), v.GetY(), v.GetZ(), w.GetX(), w.GetY(), w.GetZ() };
+		bool finite = true;
+		for (float f : vals)
+			finite = finite && isfinite(f);
+		if (!finite)
+			++nonfinite;
+		double v2 = double(v.GetX()) * v.GetX() + double(v.GetY()) * v.GetY() + double(v.GetZ()) * v.GetZ();
+		double w2 = double(w.GetX()) * w.GetX() + double(w.GetY()) * w.GetY() + double(w.GetZ()) * w.GetZ();
+		e_lin += 0.5 * v2;
+		e_rot += w2 / 3.0;
+		e_pot -= double(g.GetX()) * p.GetX() + double(g.GetY()) * p.GetY() + double(g.GetZ()) * p.GetZ();
+		if (sqrt(v2) > max_speed)
+			max_speed = sqrt(v2);
+		double x[3] = { double(p.GetX()), double(p.GetY()), double(p.GetZ()) };
+		for (int a = 0; a < 3; ++a)
+		{
+			mn[a] = min(mn[a], x[a]);
+			mx[a] = max(mx[a], x[a]);
+			sum[a] += x[a];
+		}
+	}
+	double n = bodies > 0? double(bodies) : 1.0;
+	char buf[1024];
+	snprintf(buf, sizeof(buf), "%u,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%d,%d,",
+		inStep, e_lin, e_rot, e_pot, e_lin + e_rot + e_pot, inInjected, max_speed, mn[0], mx[0], mn[1], mx[1], mn[2], mx[2], sum[0] / n, sum[1] / n, sum[2] / n, nonfinite, bodies);
+	return buf;
+}
+
+// boyko parity patch v2 (-sanity): candidate pairs with a static endpoint, by Jolt's own broadphase predicate
+// recomputed per pair (QuadTree::FindCollidingPairs: an active body's bounds expanded by the speculative
+// contact distance overlap the other body's bounds). Static-static pairs are 0 by construction: the first
+// body of every pair is active, and NON_MOVING pairs only with MOVING.
+static uint BoykoStaticCandidatePairs(PhysicsSystem &inPhysicsSystem)
+{
+	const BodyLockInterfaceNoLock &bli = inPhysicsSystem.GetBodyLockInterfaceNoLock();
+	float spec = inPhysicsSystem.GetPhysicsSettings().mSpeculativeContactDistance;
+	BodyIDVector ids;
+	inPhysicsSystem.GetBodies(ids);
+	Array<AABox> statics, active;
+	for (BodyID id : ids)
+	{
+		BodyLockRead lock(bli, id);
+		const Body &b = lock.GetBody();
+		if (b.IsStatic())
+			statics.push_back(b.GetWorldSpaceBounds());
+		else if (b.IsActive())
+		{
+			AABox bounds = b.GetWorldSpaceBounds();
+			bounds.ExpandBy(Vec3::sReplicate(spec));
+			active.push_back(bounds);
+		}
+	}
+	uint n = 0;
+	for (const AABox &a : active)
+		for (const AABox &s : statics)
+			n += a.Overlaps(s)? 1 : 0;
+	return n;
+}
+
+// boyko parity patch v2: little-endian f32 bits of every dynamic body's position, linear velocity, rotation
+// (x, y, z, w) and angular velocity, in body index order: boyko's --pose-out format
+static bool BoykoWritePose(PhysicsSystem &inPhysicsSystem, const char *inPath)
+{
+	BodyInterface &bi = inPhysicsSystem.GetBodyInterfaceNoLock();
+	BodyIDVector ids;
+	inPhysicsSystem.GetBodies(ids);
+	string out;
+	for (BodyID id : ids)
+	{
+		if (bi.GetMotionType(id) == EMotionType::Static)
+			continue;
+		Vec3 p = Vec3(bi.GetPosition(id)), v = bi.GetLinearVelocity(id), w = bi.GetAngularVelocity(id);
+		Quat q = bi.GetRotation(id);
+		float vals[13] = { p.GetX(), p.GetY(), p.GetZ(), v.GetX(), v.GetY(), v.GetZ(), q.GetX(), q.GetY(), q.GetZ(), q.GetW(), w.GetX(), w.GetY(), w.GetZ() };
+		for (float f : vals)
+		{
+			uint32 b = BoykoDyn::Bits(f);
+			char c[4] = { char(b & 0xff), char((b >> 8) & 0xff), char((b >> 16) & 0xff), char((b >> 24) & 0xff) };
+			out.append(c, 4);
+		}
+	}
+	ofstream f(inPath, ofstream::out | ofstream::binary | ofstream::trunc);
+	f.write(out.data(), streamsize(out.size()));
+	return bool(f);
+}
