+// boyko parity patch v2 (-dyn): the dynamic parity scenes on the J-T pyramid. The programs are boyko's
+// crates/boyko_physics/benches/jolt_parity_pyramid/dyn_spec.rs, derived here INDEPENDENTLY in C++ from
+// the record (docs/physics/perf-campaign/levers/scenes/01-DESIGN.md). Integer arithmetic only; every
+// float is an exact int * 2^-k, so -ffp-contract / -mfma cannot move a bit, and the scene dump must
+// equal boyko's and Rapier's byte for byte.
+namespace BoykoDyn
+{
+	enum class EProgram { None, Kick, Shoot, Slide };
+
+	// SplitMix64 (Steele, Lea, Flood 2014)
+	class SplitMix64
+	{
+	public:
+		explicit			SplitMix64(uint64 inSeed) : mState(inSeed) { }
+
+		uint64				Next()
+		{
+			mState += 0x9E3779B97F4A7C15ULL;
+			uint64 z = mState;
+			z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+			z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+			return z ^ (z >> 31);
+		}
+
+		// Uniform in [0, inN): draws below 2^64 mod inN are rejected
+		uint64				Below(uint64 inN)
+		{
+			uint64 t = (uint64(0) - inN) % inN;
+			for (;;)
+			{
+				uint64 z = Next();
+				if (z >= t)
+					return z % inN;
+			}
+		}
+
+		// Uniform in [inLo, inHi], inclusive
+		int64				Range(int64 inLo, int64 inHi)		{ return inLo + int64(Below(uint64(inHi - inLo + 1))); }
+
+	private:
+		uint64				mState;
+	};
+
+	struct Kick { uint mStep; uint mIndex; int mK[3]; };						// dv = k / 64 m/s
+	struct Launch { uint mStep; int mPos16[3]; int mVel256[3]; };			// p = pos / 16 m, v = vel / 256 m/s
+	struct StaticBox { int mHalf[3]; int mCenter[3]; };
+
+	inline const char *		Name(EProgram inP)		{ return inP == EProgram::Kick? "kick" : inP == EProgram::Shoot? "shoot" : inP == EProgram::Slide? "slide" : "none"; }
+	inline uint				Steps(EProgram inP)		{ return inP == EProgram::Kick || inP == EProgram::Shoot? 800 : 500; }
+	inline int				Events(EProgram inP)	{ return inP == EProgram::Kick? 24 : inP == EProgram::Shoot? 60 : 0; }
+
+	// Floor first, then the arena (S-SHOOT: walls whose faces stand at x, z = +-50 and a ceiling at y = 61;
+	// S-SLIDE: the same with the +x wall moved in to x = 31)
+	inline int				Statics(EProgram inP, const StaticBox *&outBoxes)
+	{
+		static const StaticBox cJT[1] = { { { 50, 1, 50 }, { 0, -1, 0 } } };
+		static const StaticBox cShoot[6] = { { { 50, 1, 50 }, { 0, -1, 0 } }, { { 1, 31, 52 }, { 51, 30, 0 } }, { { 1, 31, 52 }, { -51, 30, 0 } },
+											 { { 52, 31, 1 }, { 0, 30, 51 } }, { { 52, 31, 1 }, { 0, 30, -51 } }, { { 52, 1, 52 }, { 0, 62, 0 } } };
+		static const StaticBox cSlide[6] = { { { 50, 1, 50 }, { 0, -1, 0 } }, { { 1, 31, 52 }, { 31, 30, 0 } }, { { 1, 31, 52 }, { -51, 30, 0 } },
+											 { { 52, 31, 1 }, { 0, 30, 51 } }, { { 52, 31, 1 }, { 0, 30, -51 } }, { { 52, 1, 52 }, { 0, 62, 0 } } };
+		if (inP == EProgram::Shoot) { outBoxes = cShoot; return 6; }
+		if (inP == EProgram::Slide) { outBoxes = cSlide; return 6; }
+		outBoxes = cJT;
+		return 1;
+	}
+
+	inline float			FromBits(uint32 inBits)	{ float f; memcpy(&f, &inBits, sizeof(f)); return f; }
+	inline uint32			Bits(float inValue)		{ uint32 b; memcpy(&b, &inValue, sizeof(b)); return b; }
+
+	// S-KICK: 24 events at 200 + 25e; 62 distinct boxes drawn first, then a dv per box in draw order with
+	// 64^2 <= |k|^2 <= 320^2; applied (and returned) step-major, ascending index
+	inline Array<Kick>		KickProgram()
+	{
+		SplitMix64 rng(0x6b69636b00000001ULL);
+		Array<Kick> out;
+		for (int e = 0; e < 24; ++e)
+		{
+			uint idx[62];
+			int n = 0;
+			while (n < 62)
+			{
+				uint c = uint(rng.Below(1240));
+				bool seen = false;
+				for (int i = 0; i < n; ++i)
+					seen |= idx[i] == c;
+				if (!seen)
+					idx[n++] = c;
+			}
+			Kick ev[62];
+			for (int i = 0; i < 62; ++i)
+			{
+				int64 k[3];
+				for (;;)
+				{
+					k[0] = rng.Range(-320, 320);
+					k[1] = rng.Range(-320, 320);
+					k[2] = rng.Range(-320, 320);
+					int64 n2 = k[0] * k[0] + k[1] * k[1] + k[2] * k[2];
+					if (n2 >= 64 * 64 && n2 <= 320 * 320)
+						break;
+				}
+				ev[i] = { uint(200 + 25 * e), idx[i], { int(k[0]), int(k[1]), int(k[2]) } };
+			}
+			for (int i = 1; i < 62; ++i) // insertion sort by index
+				for (int j = i; j > 0 && ev[j - 1].mIndex > ev[j].mIndex; --j)
+				{
+					Kick t = ev[j]; ev[j] = ev[j - 1]; ev[j - 1] = t;
+				}
+			for (int i = 0; i < 62; ++i)
+				out.push_back(ev[i]);
+		}
+		return out;
+	}
+
+	// S-SHOOT: 60 launches at 200 + 10k from a 30-34 m ring around the pile axis (x = z = -1 m), 40-48 m
+	// up, each at least 30 degrees from the previous one, at 15-40 m/s toward a point 4-28 m up the axis
+	inline Array<Launch>	ShootProgram()
+	{
+		SplitMix64 rng(0x73686f6f00000001ULL);
+		Array<Launch> out;
+		bool have_prev = false;
+		int64 pa = 0, pb = 0;
+		for (int k = 0; k < 60; ++k)
+		{
+			int64 a, b;
+			for (;;)
+			{
+				a = rng.Range(-544, 544);
+				b = rng.Range(-544, 544);
+				int64 r2 = a * a + b * b;
+				if (r2 < 480 * 480 || r2 > 544 * 544)
+					continue;
+				if (have_prev)
+				{
+					int64 dot = a * pa + b * pb;
+					int64 pr2 = pa * pa + pb * pb;
+					if (!(dot <= 0 || 4 * dot * dot <= 3 * r2 * pr2))
+						continue;
+				}
+				break;
+			}
+			int64 hl = rng.Range(640, 768);
+			int64 ht = rng.Range(64, 448);
+			int64 s = rng.Range(15, 40);
+			int64 d[3] = { -a, ht - hl, -b };
+			uint64 dd = uint64(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+			uint64 n = uint64(sqrt(double(dd))); // then the exact floor: the fix-up loops make sqrt's rounding irrelevant
+			while (n * n > dd)
+				--n;
+			while ((n + 1) * (n + 1) <= dd)
+				++n;
+			Launch l;
+			l.mStep = uint(200 + 10 * k);
+			l.mPos16[0] = int(a - 16);
+			l.mPos16[1] = int(hl);
+			l.mPos16[2] = int(b - 16);
+			for (int i = 0; i < 3; ++i)
+				l.mVel256[i] = int((s * 256 * d[i]) / int64(n)); // C++ integer division truncates toward zero
+			out.push_back(l);
+			pa = a;
+			pb = b;
+			have_prev = true;
+		}
+		return out;
+	}
+
+	// One body's mechanical energy per unit J-T box mass: |v|^2 / 2 + |w|^2 / 3 - g.p (a cube of side 2 has I = 2/3 m)
+	inline double			Energy(Vec3Arg inP, Vec3Arg inV, Vec3Arg inW, Vec3Arg inG)
+	{
+		double v2 = double(inV.GetX()) * inV.GetX() + double(inV.GetY()) * inV.GetY() + double(inV.GetZ()) * inV.GetZ();
+		double w2 = double(inW.GetX()) * inW.GetX() + double(inW.GetY()) * inW.GetY() + double(inW.GetZ()) * inW.GetZ();
+		double gp = double(inG.GetX()) * inP.GetX() + double(inG.GetY()) * inP.GetY() + double(inG.GetZ()) * inP.GetZ();
+		return 0.5 * v2 + w2 / 3.0 - gp;
+	}
+
+	inline void				AppendHex(string &ioOut, float inValue)
+	{
+		char buf[16];
+		snprintf(buf, sizeof(buf), " %08x", uint(Bits(inValue)));
+		ioOut += buf;
+	}
+
+	// A dynamic body's dump fields as READ BACK from Jolt (boyko's BodyLine::write_fields order)
+	inline void				AppendBodyFields(string &ioOut, const Body &inBody, uint inIndex, float inBox0InvMass, Vec3Arg inBox0InvInertia)
+	{
+		ioOut += to_string(inIndex);
+		RVec3 p = inBody.GetPosition();
+		Quat q = inBody.GetRotation();
+		Vec3 v = inBody.GetLinearVelocity(), w = inBody.GetAngularVelocity();
+		const Shape *shape = inBody.GetShape();
+		bool box = shape->GetSubType() == EShapeSubType::Box;
+		Vec3 half = box? static_cast<const BoxShape *>(shape)->GetHalfExtent() : Vec3::sReplicate(nanf(""));
+		float radius = box? static_cast<const BoxShape *>(shape)->GetConvexRadius() : nanf("");
+		const MotionProperties *mp = inBody.GetMotionPropertiesUnchecked();
+		float fields[] = { float(p.GetX()), float(p.GetY()), float(p.GetZ()), q.GetX(), q.GetY(), q.GetZ(), q.GetW(),
+						   v.GetX(), v.GetY(), v.GetZ(), w.GetX(), w.GetY(), w.GetZ(), half.GetX(), half.GetY(), half.GetZ(),
+						   inBody.GetFriction(), inBody.GetRestitution(), radius, mp->GetInverseMass() / inBox0InvMass,
+						   mp->GetInverseInertiaDiagonal().GetX() / inBox0InvInertia.GetX(), mp->GetInverseInertiaDiagonal().GetY() / inBox0InvInertia.GetY(),
+						   mp->GetInverseInertiaDiagonal().GetZ() / inBox0InvInertia.GetZ(), mp->GetLinearDamping(), mp->GetAngularDamping() };
+		for (float f : fields)
+			AppendHex(ioOut, f);
+		ioOut += inBody.GetAllowSleeping()? " 1" : " 0";
+		ioOut += mp->GetMotionQuality() == EMotionQuality::LinearCast? " 1" : " 0";
+	}
+}
