+// boyko parity patch (-receipt): counts the manifolds the contact listener sees per update, cache hits
+// included (the body pair cache reports every cached manifold through OnContactPersisted). Callbacks
+// arrive from every job thread, hence the atomics. Untimed: it is only installed under -receipt.
+class ReceiptContactListener : public ContactListener
+{
+public:
+	virtual void			OnContactAdded([[maybe_unused]] const Body &inBody1, [[maybe_unused]] const Body &inBody2, const ContactManifold &inManifold, [[maybe_unused]] ContactSettings &ioSettings) override { Count(inManifold); }
+	virtual void			OnContactPersisted([[maybe_unused]] const Body &inBody1, [[maybe_unused]] const Body &inBody2, const ContactManifold &inManifold, [[maybe_unused]] ContactSettings &ioSettings) override { Count(inManifold); }
+
+	void					Reset()								{ mManifolds = 0; mPoints = 0; }
+	uint					GetManifolds() const				{ return mManifolds.load(memory_order_relaxed); }
+	uint					GetPoints() const					{ return mPoints.load(memory_order_relaxed); }
+
+private:
+	void					Count(const ContactManifold &inManifold)
+	{
+		mManifolds.fetch_add(1, memory_order_relaxed);
+		mPoints.fetch_add(uint(inManifold.mRelativeContactPointsOn1.size()), memory_order_relaxed);
+	}
+
+	atomic<uint>			mManifolds { 0 };
+	atomic<uint>			mPoints { 0 };
+};
