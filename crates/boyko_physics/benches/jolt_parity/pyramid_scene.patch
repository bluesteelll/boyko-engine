+// boyko parity patch v2 (-dyn): J-T (PyramidScene::StartTest, unchanged) plus a dynamic program, applied by
+// ApplyEvents between updates, outside the timed pair
+class BoykoDynPyramidScene : public PyramidScene
+{
+public:
+	explicit				BoykoDynPyramidScene(BoykoDyn::EProgram inProgram) : mProgram(inProgram) { }
+
+	virtual void			StartTest(PhysicsSystem &inPhysicsSystem, EMotionQuality inMotionQuality) override
+	{
+		PyramidScene::StartTest(inPhysicsSystem, inMotionQuality); // J-T exactly: the floor, then the 1240 boxes
+
+		// The dynamic bodies in creation order (body index order on a fresh system)
+		BodyInterface &bi = inPhysicsSystem.GetBodyInterfaceNoLock();
+		BodyIDVector ids;
+		inPhysicsSystem.GetBodies(ids);
+		mBoxes.clear();
+		for (BodyID id : ids)
+			if (bi.GetMotionType(id) != EMotionType::Static)
+				mBoxes.push_back(id);
+
+		// The arena after the boxes, as in every harness
+		const BoykoDyn::StaticBox *statics = nullptr;
+		int n = BoykoDyn::Statics(mProgram, statics);
+		for (int i = 1; i < n; ++i)
+		{
+			const BoykoDyn::StaticBox &s = statics[i];
+			bi.CreateAndAddBody(BodyCreationSettings(new BoxShape(Vec3(float(s.mHalf[0]), float(s.mHalf[1]), float(s.mHalf[2])), 0.0f), RVec3(Real(s.mCenter[0]), Real(s.mCenter[1]), Real(s.mCenter[2])), Quat::sIdentity(), EMotionType::Static, Layers::NON_MOVING), EActivation::DontActivate);
+		}
+
+		// S-SLIDE: gravity 9.81 (sin t, -cos t, 0) with tan t = 1/2, rounded once to f32: y is exactly -2x
+		if (mProgram == BoykoDyn::EProgram::Slide)
+			inPhysicsSystem.SetGravity(Vec3(BoykoDyn::FromBits(0x408c63a9), BoykoDyn::FromBits(0xc10c63a9), 0.0f));
+
+		mKicks = mProgram == BoykoDyn::EProgram::Kick? BoykoDyn::KickProgram() : Array<BoykoDyn::Kick>();
+		mLaunches = mProgram == BoykoDyn::EProgram::Shoot? BoykoDyn::ShootProgram() : Array<BoykoDyn::Launch>();
+		mNextKick = 0;
+		mNextLaunch = 0;
+		mProjectile = new BoxShape(Vec3::sReplicate(1.0f), 0.0f); // the J-T box shape
+	}
+
+	virtual void			ApplyEvents(PhysicsSystem &inPhysicsSystem, uint inStep, BoykoDynLog &ioLog) override
+	{
+		BodyInterface &bi = inPhysicsSystem.GetBodyInterfaceNoLock();
+		const BodyLockInterfaceNoLock &bli = inPhysicsSystem.GetBodyLockInterfaceNoLock();
+		Vec3 g = inPhysicsSystem.GetGravity();
+		bool kicked = false;
+		while (mNextKick < mKicks.size() && mKicks[mNextKick].mStep == inStep)
+		{
+			const BoykoDyn::Kick &k = mKicks[mNextKick++];
+			BodyID id = mBoxes[k.mIndex];
+			Vec3 dv(float(k.mK[0]) * (1.0f / 64.0f), float(k.mK[1]) * (1.0f / 64.0f), float(k.mK[2]) * (1.0f / 64.0f));
+			Vec3 p = Vec3(bi.GetPosition(id)), w = bi.GetAngularVelocity(id);
+			Vec3 before = bi.GetLinearVelocity(id);
+			double e0 = BoykoDyn::Energy(p, before, w, g);
+			bi.AddLinearVelocity(id, dv);
+			Vec3 after = bi.GetLinearVelocity(id);
+			Vec3 want(before.GetX() + dv.GetX(), before.GetY() + dv.GetY(), before.GetZ() + dv.GetZ());
+			bool ok = BoykoDyn::Bits(after.GetX()) == BoykoDyn::Bits(want.GetX()) && BoykoDyn::Bits(after.GetY()) == BoykoDyn::Bits(want.GetY()) && BoykoDyn::Bits(after.GetZ()) == BoykoDyn::Bits(want.GetZ());
+			ioLog.mInjected += BoykoDyn::Energy(p, after, w, g) - e0;
+			ioLog.mReadbackMismatches += ok? 0 : 1;
+			ioLog.mKicksApplied++;
+			if (ioLog.mRecordDump)
+			{
+				ioLog.mDumpLines += "kick " + to_string(k.mStep) + " " + to_string(k.mIndex);
+				if (ok)
+				{
+					BoykoDyn::AppendHex(ioLog.mDumpLines, dv.GetX());
+					BoykoDyn::AppendHex(ioLog.mDumpLines, dv.GetY());
+					BoykoDyn::AppendHex(ioLog.mDumpLines, dv.GetZ());
+				}
+				else
+					ioLog.mDumpLines += " READBACK-MISMATCH";
+				ioLog.mDumpLines += "\n";
+			}
+			kicked = true;
+		}
+		if (kicked)
+			ioLog.mEventsApplied++;
+		while (mNextLaunch < mLaunches.size() && mLaunches[mNextLaunch].mStep == inStep)
+		{
+			const BoykoDyn::Launch &l = mLaunches[mNextLaunch++];
+			Vec3 p(float(l.mPos16[0]) * (1.0f / 16.0f), float(l.mPos16[1]) * (1.0f / 16.0f), float(l.mPos16[2]) * (1.0f / 16.0f));
+			Vec3 v(float(l.mVel256[0]) * (1.0f / 256.0f), float(l.mVel256[1]) * (1.0f / 256.0f), float(l.mVel256[2]) * (1.0f / 256.0f));
+
+			// The clearance: the spawn point's distance to the nearest dynamic body's centre
+			double clearance = 1.0e300;
+			for (BodyID id : mBoxes)
+			{
+				Vec3 c = Vec3(bi.GetPosition(id));
+				double dx = double(c.GetX()) - p.GetX(), dy = double(c.GetY()) - p.GetY(), dz = double(c.GetZ()) - p.GetZ();
+				clearance = min(clearance, sqrt(dx * dx + dy * dy + dz * dz));
+			}
+			ioLog.mClearance = clearance;
+			ioLog.mClearanceMin = min(ioLog.mClearanceMin, clearance);
+
+			// The J-T box's settings (PyramidScene.h), with the launch velocity
+			BodyCreationSettings settings(mProjectile, RVec3(p), Quat::sIdentity(), EMotionType::Dynamic, Layers::MOVING);
+			settings.mAllowSleeping = false;
+			settings.mLinearDamping = 0.0f;
+			settings.mAngularDamping = 0.0f;
+			settings.mLinearVelocity = v;
+			BodyID id = bi.CreateAndAddBody(settings, EActivation::Activate);
+			mBoxes.push_back(id);
+
+			BodyLockRead lock(bli, id);
+			const Body &body = lock.GetBody();
+			ioLog.mInjected += BoykoDyn::Energy(Vec3(body.GetPosition()), body.GetLinearVelocity(), body.GetAngularVelocity(), g);
+			ioLog.mLaunchesApplied++;
+			ioLog.mEventsApplied++;
+			if (ioLog.mRecordDump)
+			{
+				BodyLockRead lock0(bli, mBoxes[0]);
+				const MotionProperties *mp0 = lock0.GetBody().GetMotionPropertiesUnchecked();
+				ioLog.mDumpLines += "launch " + to_string(l.mStep) + " ";
+				BoykoDyn::AppendBodyFields(ioLog.mDumpLines, body, uint(mBoxes.size() - 1), mp0->GetInverseMass(), mp0->GetInverseInertiaDiagonal());
+				ioLog.mDumpLines += "\n";
+			}
+		}
+	}
+
+private:
+	BoykoDyn::EProgram		mProgram;
+	BodyIDVector			mBoxes;
+	Array<BoykoDyn::Kick>	mKicks;
+	Array<BoykoDyn::Launch>	mLaunches;
+	size_t					mNextKick = 0;
+	size_t					mNextLaunch = 0;
+	RefConst<Shape>			mProjectile;
 };
